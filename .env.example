# eShop_AI — example environment configuration
#
# Copy to `.env` for local development:  cp .env.example .env
# `.env` and `.env.*` are git-ignored; only this example file is committed.
#
# CURRENTLY SUPPORTED SETTINGS: APP_ENV, APP_DEBUG, BACKEND_HOST,
# BACKEND_PORT, SHUTDOWN_TIMEOUT_SECONDS, LOG_LEVEL, LOG_FORMAT and
# FEATURE_*. Every other group below is planned; it names the milestone and
# task in which it becomes supported, and its names and defaults are
# proposals until then.
#
# Rules:
# - Placeholders only. Never put real credentials in this file.
# - Replace every `change-me` value in your local `.env` with a generated
#   secret:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# - Defaults are safe: mock AI, external sources off, no cloud access.
# - Cloud environments use a managed secrets service, not .env files.

# -----------------------------------------------------------------------------
# Application environment — M1 (SHOP-010, SHOP-015 and SHOP-016 implemented)
# -----------------------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
APP_DEBUG=false
# Planned (SHOP-019): public URL of the frontend; also the only allowed browser origin.
APP_PUBLIC_URL=http://localhost:3000
# Backend listen address (SHOP-010); 127.0.0.1 keeps it local to this machine.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Implemented (SHOP-122): host ports published by Docker Compose (bound to
# 127.0.0.1). Inside the containers the apps always listen on 8000 and 3000.
FRONTEND_PORT=3000
# Implemented (SHOP-015): read by the Next.js server at runtime for server-side
# requests and the /api/v1 proxy; default http://127.0.0.1:8000 when unset.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# Planned (SHOP-019): comma-separated allowed browser origins (CORS and Origin checks).
ALLOWED_ORIGINS=http://localhost:3000
# Graceful shutdown timeout for in-flight requests (NFR-REL-008).
SHUTDOWN_TIMEOUT_SECONDS=20

# Feature flags — implemented (SHOP-016); safe (off) by default (FR-PLAT-013)
# ai_assistant is the only flag exposed to the frontend; the others are server-only.
FEATURE_AI_ASSISTANT=false
FEATURE_EXTERNAL_PRODUCT_SOURCES=false
FEATURE_NOTIFICATIONS=false

# -----------------------------------------------------------------------------
# Logging — implemented (SHOP-012); tracing and metrics planned, M8
# -----------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | console (json in all shared environments)
LOG_FORMAT=json
OTEL_SERVICE_NAME=eshop-backend
# Empty disables trace export. Local collector example: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=false

# -----------------------------------------------------------------------------
# Database (PostgreSQL) — planned, M2 (SHOP-022, SHOP-023)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eshop
# Application role: data access only.
POSTGRES_USER=eshop_app
POSTGRES_PASSWORD=change-me-local-only
# Migration role: schema changes only (least privilege).
POSTGRES_MIGRATION_USER=eshop_migrator
POSTGRES_MIGRATION_PASSWORD=change-me-local-only

# -----------------------------------------------------------------------------
# Redis — planned, M3 (SHOP-030)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me-local-only

# -----------------------------------------------------------------------------
# Sessions and CSRF — planned, M3 (SHOP-031, SHOP-032; ADR-0004)
# -----------------------------------------------------------------------------
# Session store is undecided (UD-08, SHOP-030): redis | postgresql
SESSION_STORE=
# Secret for signing and hashing session and CSRF values. Generate locally.
SESSION_SECRET_KEY=change-me-generate-a-random-value
# false only for local HTTP development; true everywhere else.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Approved initial defaults (SHOP-006; FR-AUTH-005): customers 30 min idle /
# 7 days maximum; back-office roles 15 min idle / 8 hours maximum.
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=168
ADMIN_SESSION_IDLE_TIMEOUT_MINUTES=15
ADMIN_SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# -----------------------------------------------------------------------------
# Gatekeeper limits — planned, M3 (SHOP-033) and M5 (SHOP-054)
# -----------------------------------------------------------------------------
# Approved initial defaults (SHOP-006); all limits are configurable.
# Sign-in limits apply per account identifier and per client IP address.
RATE_LIMIT_SIGNIN_PER_MINUTE=5
RATE_LIMIT_REGISTRATION_PER_HOUR=10
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_ASSISTANT_PER_SESSION_PER_HOUR=30
# Global daily token budget for real AI providers (NFR-AI-015, UD-06).
# 0 means real providers are not allowed to consume tokens. Approved default:
# stays 0 until the project owner explicitly configures a budget.
AI_DAILY_TOKEN_BUDGET=0

# -----------------------------------------------------------------------------
# AI providers — planned, M6 (SHOP-064, SHOP-065)
# -----------------------------------------------------------------------------
# mock is the default. Enabling a paid provider requires explicit owner
# approval and a non-zero daily token budget.
LLM_PROVIDER=mock
LLM_MODEL=
# Leave empty unless a paid API has been approved.
LLM_API_KEY=
# Limits from PRD section 10.6; validated at startup (NFR-AI-017).
AI_MAX_MESSAGE_CHARS=2000
AI_MAX_TOOL_CALLS_PER_TURN=5
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=800
AI_HISTORY_TURNS=10

# -----------------------------------------------------------------------------
# Object storage for product images — planned, M5; backend undecided (UD-09)
# -----------------------------------------------------------------------------
# local | s3 (decided in SHOP-051 and SHOP-093)
STORAGE_BACKEND=
# Local directory (git-ignored) used when STORAGE_BACKEND=local.
STORAGE_LOCAL_PATH=.local-data/images
# S3 or S3-compatible settings. Never put AWS access keys here: use IAM
# roles in the cloud and short-lived credentials locally.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT_URL=

# -----------------------------------------------------------------------------
# Product imports and external product sources — planned, M5
# -----------------------------------------------------------------------------
# Maximum upload size for CSV/JSON imports (NFR-SEC-011).
IMPORT_MAX_UPLOAD_MB=10
# External sources are ADV and undecided (UD-03). Comma-separated source
# identifiers; empty means none are enabled.
PRODUCT_SOURCES_ENABLED=
# Outbound host allow-list for SSRF protection (NFR-SEC-017).
OUTBOUND_ALLOWED_HOSTS=
PRODUCT_SOURCE_TIMEOUT_SECONDS=10
PRODUCT_SOURCE_CACHE_TTL_SECONDS=86400
# Per-source credentials are added here as PRODUCT_SOURCE_<NAME>_API_KEY
# when a source is approved (SHOP-058).

# -----------------------------------------------------------------------------
# Notifications — planned, M5 (SHOP-057, ADV); mail catcher undecided (UD-15)
# -----------------------------------------------------------------------------
# Local mail catcher only; no real email delivery.
SMTP_HOST=localhost
SMTP_PORT=
NOTIFICATIONS_FROM_ADDRESS=no-reply@eshop-ai.local

# -----------------------------------------------------------------------------
# Frontend public configuration — planned, M1 (SHOP-014)
# -----------------------------------------------------------------------------
# Only intentionally public values may use the NEXT_PUBLIC_ prefix; they are
# embedded in browser bundles. Never put secrets here.
NEXT_PUBLIC_APP_NAME=eShop_AI
