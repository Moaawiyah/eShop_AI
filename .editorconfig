# Editor defaults shared across IDEs (https://editorconfig.org).
# Formatters (Ruff, Prettier, terraform fmt) remain authoritative from M1.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[{Makefile,*.mk,go.mod}]
indent_style = tab
